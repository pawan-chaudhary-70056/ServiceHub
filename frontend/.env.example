# ---------------------------------------------------------------------------
# ServiceHub frontend configuration.
#
# ⚠️  EVERY VARIABLE HERE IS PUBLIC.
#
# Vite compiles `VITE_*` variables into the JavaScript bundle that ships to the browser.
# Anyone can read them. Never put an API key, token, credential or internal hostname
# here — a secret in a VITE_ variable is a leaked secret (docs/35 §2, docs/38 §8).
#
# Anything genuinely secret belongs on the backend, injected at runtime.
# ---------------------------------------------------------------------------

# Base URL the SPA calls (docs/11 §1: the API base path is /api/v1).
#   Development: `/api/v1` (the Vite dev server proxies `/api` to the backend, so the
#                browser sees one origin and CORS is not involved).
#   Production:  `/api/v1` served by the edge/load balancer, or an absolute origin.
VITE_API_BASE_URL=/api/v1

# Application name shown in the header and the document title.
VITE_APP_NAME=ServiceHub
