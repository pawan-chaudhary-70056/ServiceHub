# ---------------------------------------------------------------------------
# ServiceHub backend configuration.
#
# Copy to `.env` and adjust. Every variable here is validated at boot with Zod
# (docs/35 §2): a missing or malformed required value fails fast rather than
# surfacing later as a runtime error.
#
# NEVER commit a real `.env`. Secrets are injected at runtime in deployed
# environments (docs/17, docs/35 §7).
# ---------------------------------------------------------------------------

# Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Trust the load balancer / proxy for client IP (needed for rate limiting and
# audit source IP). Enable only behind a known proxy — docs/17.
TRUST_PROXY=false

# Database ---------------------------------------------------------------
# The connection budget is stated arithmetic: instances x pool size + workers
# <= Postgres budget - reserve (docs/33 §4). Do not raise max_connections.
DATABASE_URL=postgresql://servicehub:servicehub@localhost:5432/servicehub?schema=public

# Cache and async tier ---------------------------------------------------
# Redis is the cache and broker (docs/42 ADR-0003). Optional locally: the app
# degrades to database reads and defers delivery when absent (docs/33 §16).
REDIS_URL=redis://localhost:6379

# HTTP -------------------------------------------------------------------
# Comma-separated list of allowed origins. No wildcard in production.
CORS_ORIGIN=http://localhost:5173

# Rate limiting ----------------------------------------------------------
# Coarse baseline at the application layer; the edge applies its own limits
# (docs/33 §6). Authentication routes use the tighter bucket below.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Credential endpoints (/auth/login, /forgot, /reset, /accept-invitation) are the
# most expensive surface to brute-force, so they carry a materially tighter bucket.
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# Authentication ---------------------------------------------------------
# Server-side sessions in Redis, delivered in an httpOnly cookie (ADRs 0001/0003).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 characters. Rotating this invalidates existing sessions.
AUTH_SECRET=replace-me-with-a-long-random-development-only-value

# Session lifecycle (ADR-0001, docs/06 §7). A session dies at the idle timeout OR
# the absolute maximum, whichever comes first. Cookies are HttpOnly and SameSite=Lax;
# Secure is applied automatically when NODE_ENV=production.
SESSION_COOKIE_NAME=servicehub_session
CSRF_COOKIE_NAME=servicehub_csrf
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# TTL of the shared session-lookup cache in Redis (docs/33 §5, rule C2). Bounded
# staleness; explicit invalidation on revocation is the primary control.
SESSION_CACHE_TTL_SECONDS=60

# Account lockout (docs/06 §6) and invitation lifetime (docs/06 §11).
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
INVITATION_TTL_HOURS=72

# Password policy (docs/06 §4): minimum 12, maximum 128.
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128

# Public URL of the SPA, used to compose the invitation link in the email payload.
APP_BASE_URL=http://localhost:5173

# Password hashing (Argon2id) --------------------------------------------
# Floors are set by docs/06 §4: memory ≥ 64 MiB (65536 KiB) and iterations ≥ 3.
# These are tuned upward at deploy if capacity allows, never below the floor.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Email (ADR-0006: Knock → SendGrid) -------------------------------------
# Local development uses the mailpit container from docker-compose.yml.
# Delivery is queued via the outbox, never awaited inline (docs/29).
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=ServiceHub <no-reply@servicehub.local>

# Bootstrap (one-time only, docs/10 §8, ADR-0012) -------------------------
# Read ONLY by `npm run bootstrap:operator`, which creates the first platform
# operator. Not needed by a running server, and there is deliberately no default
# credential. If unset, the command refuses rather than inventing one.
# BOOTSTRAP_OPERATOR_EMAIL=
# BOOTSTRAP_OPERATOR_PASSWORD=
# BOOTSTRAP_OPERATOR_NAME=Platform Operator
